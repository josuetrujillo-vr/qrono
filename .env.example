# Solo estas variables VITE_ son públicas y llegan al navegador.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=REEMPLAZAR_POR_ANON_KEY_LOCAL
VITE_APP_URL=http://localhost:5173

# NO usar prefijo VITE_ para secretos. Copiar al archivo supabase/.env.
